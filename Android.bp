soong_namespace {
}

// Vendor Display & Touch Libraries
cc_prebuilt_library_shared {
    name: "vendor.display.config@1.0",
    owner: "realme",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/vendor.display.config@1.0.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

